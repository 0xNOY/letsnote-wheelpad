#!/bin/sh
set -e

persistent_marker=/etc/letsnote-wheelpad/system-service-enabled
staging_marker=/run/letsnote-wheelpad/migration-staging
user_block_marker=/run/letsnote-wheelpad/migration-block-user-service
daemon=/usr/bin/letsnote-wheelpad

running_daemons()
{
    for process_exe in /proc/[0-9]*/exe; do
        [ -L "$process_exe" ] || continue
        resolved=$(readlink "$process_exe" 2>/dev/null) || continue
        case "$resolved" in
            "$daemon"|"$daemon (deleted)")
                printf '%s\n' "${process_exe#/proc/}" | cut -d/ -f1
                ;;
        esac
    done
}

removal_error()
{
    echo "letsnote-wheelpad: package removal is blocked by migration state or a running daemon" >&2
    echo "Run: /usr/libexec/letsnote-wheelpad-migrate status" >&2
    echo "Disable system mode when active, stop the intended legacy user service," >&2
    echo "then retry package removal." >&2
}

downgrade_error()
{
    echo "letsnote-wheelpad: downgrade requires explicit migration rollback and stopped daemons" >&2
    echo "Run migration status, disable system mode, stop the intended legacy user service," >&2
    echo "then retry the downgrade." >&2
}

case "${1:-}" in
    remove)
        if [ -e "$persistent_marker" ] || [ -e "$staging_marker" ] ||
            [ -e "$user_block_marker" ] || [ -n "$(running_daemons)" ]; then
            removal_error
            exit 1
        fi
        if command -v systemctl >/dev/null 2>&1; then
            systemctl --global disable letsnote-wheelpad.service || true
        fi
        ;;
    upgrade)
        if [ -e "$staging_marker" ] || [ -e "$user_block_marker" ]; then
            downgrade_error
            exit 1
        fi

        installed_version=$(dpkg-query -W -f='${Version}' letsnote-wheelpad 2>/dev/null || true)
        new_version=${2:-}
        if [ -n "$installed_version" ] && [ -n "$new_version" ] &&
            dpkg --compare-versions "$new_version" lt "$installed_version"; then
            if [ -e "$persistent_marker" ] || [ -e "$staging_marker" ] ||
                [ -e "$user_block_marker" ] || [ -n "$(running_daemons)" ]; then
                downgrade_error
                exit 1
            fi
        fi
        ;;
esac

exit 0
