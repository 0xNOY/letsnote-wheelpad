[Unit]
Description=Let's Note WheelPad (circular touchpad scroll)
Documentation=https://github.com/Nerahikada/letsnote-wheelpad
After=graphical-session.target
PartOf=graphical-session.target
ConditionPathExists=!/etc/letsnote-wheelpad/system-service-enabled
ConditionPathExists=!/run/letsnote-wheelpad/migration-block-user-service

[Service]
Type=notify
ExecStart=/usr/bin/letsnote-wheelpad
Restart=on-failure
RestartSec=2s
StandardOutput=journal
StandardError=journal
# Defensive — never want a runaway daemon hogging the touchpad.
Nice=0

[Install]
WantedBy=graphical-session.target
